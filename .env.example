PORT=3000
NODE_ENV=development
JWT_SECRET=thay-doi-chuoi-bi-mat-nay
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VIEWER_USERNAME=theodoi
VIEWER_PASSWORD=xem123

# Bắt buộc trên Render để theodoi vẫn xem được khi admin offline
# Tạo token tại: GitHub → Settings → Developer settings → Personal access tokens
# Quyền cần: Contents Read/Write của repo Muctieu
GITHUB_TOKEN=
GITHUB_REPO=TranDinhHung2003/Muctieu
GITHUB_BRANCH=cursor/muc-tieu-chay-xe-becf
# Tùy chọn: khóa Web Push cố định (khuyến nghị set trên Render để không đổi sau restart)
# Nếu trống, server tự tạo và lưu bền vào GitHub (cần GITHUB_TOKEN)
# VAPID subject PHẢI là mailto:email-thật hoặc https://... — Apple từ chối @localhost / *.local
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Giữ Render không sleep (kèm plan starter + GitHub Action ping)
# KEEP_ALIVE_URL=https://muctieu-chay-xe.onrender.com
# KEEP_ALIVE_MS=300000
